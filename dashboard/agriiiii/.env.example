# GROQ_API_KEY: Required for the AI incident report generation.
# Get one at https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# GROQ_MODEL: Optional. Any Groq chat model id, e.g. openai/gpt-oss-120b
GROQ_MODEL="openai/gpt-oss-120b"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
